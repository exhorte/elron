# Copier vers .env.local (non versionné). Aucune valeur ci-dessous n'est un secret de production.
DATABASE_URL=postgres://alx:alx@localhost:5433/alx
TEST_DATABASE_URL=postgres://alx:alx@localhost:5433/alx_test

# Secret HMAC pour les codes de remise. OBLIGATOIRE en production (>= 32 caractères aléatoires).
# En développement/test, une valeur de repli non secrète est utilisée.
DELIVERY_CODE_PEPPER=

# Commission plateforme en points de base (100 = 1 %). 0 tant qu'aucun modèle économique n'est validé.
PLATFORM_FEE_BPS=0

# Inclure les données de démonstration dans la recherche (false par défaut).
ALX_SHOW_DEMO=false

# --- Lot 2 ---
# Nombre de proxys de confiance devant l'application (lecture de X-Forwarded-For pour la limitation de débit).
# 0 = ignorer l'en-tête (défaut, un seul compteur commun). À régler en production (ex. 1 derrière un reverse proxy).
TRUSTED_PROXY_HOPS=0

# URL publique, utilisée dans les e-mails (obligatoire en production). Jamais déduite de l'en-tête Host.
APP_BASE_URL=http://localhost:3000

# Transport e-mail : "console" (développement, affiche le message dans les journaux ; REFUSÉ en production)
# ou "disabled" (n'envoie rien ; défaut en production). Aucun fournisseur réel n'est intégré.
MAIL_TRANSPORT=console

# Stockage des preuves téléversées : "local" uniquement. UPLOAD_DIR obligatoire en production
# (volume persistant, hors du dossier public). Défaut en développement : .data/uploads
STORAGE_DRIVER=local
UPLOAD_DIR=