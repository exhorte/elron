# Copier vers .env.local (non versionné). Aucune valeur ci-dessous n'est un secret de production.
DATABASE_URL=postgres://alx:alx@localhost:5433/alx
TEST_DATABASE_URL=postgres://alx:alx@localhost:5433/alx_test

# Secret HMAC pour les codes de remise. OBLIGATOIRE en production (>= 32 caractères aléatoires).
# En développement/test, une valeur de repli non secrète est utilisée.
DELIVERY_CODE_PEPPER=

# Commission plateforme en points de base (100 = 1 %). 0 tant qu'aucun modèle économique n'est validé.
PLATFORM_FEE_BPS=0

# Inclure les données de démonstration dans la recherche (false par défaut).
ALX_SHOW_DEMO=false
